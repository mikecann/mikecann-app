{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mikecann-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mikecann.app",
      "custom_domain": true
    },
    {
      "pattern": "www.mikecann.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
